rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Keep this value in sync with VITE_ADMIN_EMAIL. This checks the
      // immutable Firebase Auth token, not a user-controlled Firestore field.
      return isSignedIn()
        && request.auth.token.email == 'admin@fashioneyecare.com';
    }

    function userOwns(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if userOwns(userId) || isAdmin();
      allow create: if userOwns(userId) || isAdmin();
      allow update, delete: if userOwns(userId) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if userOwns(userId);
    }

    match /wishlists/{userId} {
      allow read, write: if userOwns(userId);
    }

    match /orders/{orderId} {
      // Booking is intentionally public; only the authenticated admin can
      // read or manage submitted appointments.
      allow create: if true;
      allow read: if isAdmin() || userOwns(resource.data.userId);
      allow update: if isAdmin() || userOwns(resource.data.userId);
    }

    match /appointments/{appointmentId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || userOwns(resource.data.userId);
      allow update: if isAdmin() || userOwns(resource.data.userId);
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /addresses/{userId}/items/{addressId} {
      allow read, write: if userOwns(userId);
    }

    match /prescriptions/{userId}/items/{prescriptionId} {
      allow read, write: if userOwns(userId) || isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || userOwns(resource.data.userId);
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || userOwns(resource.data.userId);
      allow write: if isAdmin();
    }

    match /newsletter/{subscriberId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || userOwns(resource.data.userId);
      allow write: if isAdmin();
    }
  }
}
